# RabbitMQ
# docker compose deste projeto mapeia 5673->5672 (evita conflito com outros Rabbit locais)
RABBITMQ_URL=amqp://stone:stone@localhost:5673/
RABBITMQ_QUEUE_CARTAO=stone.cartao.transactions

# Stone Conciliation API
STONE_MERCHANT_ID=116852622
STONE_CONCILIATION_BASE_URL=https://conciliation.stone.com.br/v2
STONE_API_TOKEN=

# Dev: caminho do XML de cartão (bypass da API Stone)
STONE_CARTAO_SAMPLE_PATH=../stone_movimento_20260708_cartao.xml

# GMAIL (opcional — notificação futura)
GMAIL_USER=
GMAIL_PASS=

# POSTGRES staging
POSTGRES_USER=
POSTGRES_PASS=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=

