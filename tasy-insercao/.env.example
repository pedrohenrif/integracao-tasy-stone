# RabbitMQ (compartilhado com stone-extracao)
RABBITMQ_URL=amqp://stone:stone@localhost:5673/
RABBITMQ_QUEUE_CARTAO=stone.cartao.transactions
RABBITMQ_QUEUE_RETRY=stone.cartao.transactions.retry
RABBITMQ_QUEUE_DLQ=stone.cartao.transactions.dlq
RABBITMQ_QUEUE_PIX=stone.pix.transactions
RABBITMQ_QUEUE_PIX_RETRY=stone.pix.transactions.retry
RABBITMQ_QUEUE_PIX_DLQ=stone.pix.transactions.dlq
RABBITMQ_EXCHANGE=stone.direct

# Retry: não descarta a transação; reenvia após delay
RETRY_MAX_ATTEMPTS=5
RETRY_DELAYS_SECONDS=30,60,120,300,600
# Consumer: timeout Oracle por msg + heartbeat + reconexão automática
CONSUMER_HANDLER_TIMEOUT_SECONDS=180
CONSUMER_HEARTBEAT_SECONDS=300
CONSUMER_RECONNECT_DELAY_SECONDS=5
# Fecha o ultimo recebimento quando a fila de cartao esvazia (troca de serial ja FECHA na hora)
FECHAR_ULTIMO_RECEB_ENABLED=true

# Postgres staging (homolog)
POSTGRES_USER=
POSTGRES_PASS=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=

# Oracle Tasy (homolog)
ORACLE_USER=
ORACLE_PASS=
ORACLE_DSN=
# Sessão Tasy no FECHAR (CTB exige perfil; ADM DO SISTEMA = 1848)
TASY_NM_USUARIO=stone
TASY_CD_ESTABELECIMENTO=1
TASY_CD_PERFIL=1848

# Portal React (API :8001 + front portal-controle)
PORTAL_JWT_SECRET=altere-este-secret-em-producao
PORTAL_JWT_EXPIRE_HOURS=12
PORTAL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://10.1.1.190:5173,http://stone.financeiro:5173
PORTAL_ADMIN_USER=admin
PORTAL_ADMIN_PASS=admin123
RABBITMQ_MGMT_URL=http://localhost:15673
RABBITMQ_MGMT_USER=stone
RABBITMQ_MGMT_PASS=stone

# stone-extracao (reprocessar dia no portal)
STONE_EXTRACAO_BASE_URL=http://localhost:8000

# Mesmo valor em stone-extracao (PORTAL_INTERNAL_TOKEN) para cron → auditoria
# e para POST /interno/tesouraria/fechar-recebimentos-abertos
PORTAL_INTERNAL_TOKEN=

APP_NAME=tasy-insercao
APP_ENV=homolog
