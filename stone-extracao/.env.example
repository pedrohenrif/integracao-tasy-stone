# RabbitMQ (compartilhado com tasy-insercao)
RABBITMQ_URL=amqp://stone:stone@localhost:5673/
RABBITMQ_QUEUE_CARTAO=stone.cartao.transactions
RABBITMQ_QUEUE_PIX=stone.pix.transactions
RABBITMQ_EXCHANGE=stone.direct

# Stone API — Cartão (StoneCode)
# Auth Cliente Stone: Basic Auth (chave:) + header x-user-type: client
STONE_MERCHANT_ID=116852622
STONE_CONCILIATION_BASE_URL=https://conciliation.stone.com.br/v2
STONE_API_TOKEN=

# Stone API — PIX (CNPJ merchant)
STONE_PIX_MERCHANT_ID=76610690000162

# true = samples locais. false = API real (exige STONE_API_TOKEN)
STONE_USE_SAMPLE=false
STONE_CARTAO_SAMPLE_PATH=../stone_movimento_20260708_cartao.xml
STONE_PIX_SAMPLE_PATH=../stone_movimento_20260708_pix.xml

# Opcional: validação extra do webhook PIX (header X-Stone-Signature)
# Só use se configurar um segredo próprio no proxy; a Stone oficial não exige.
PIX_WEBHOOK_SECRET=

# Backup físico do XML de cartão na VM (data/xml_backup/cartao/YYYY/YYYYMMDD/)
STONE_XML_BACKUP_ENABLED=true
STONE_XML_BACKUP_DIR=data/xml_backup

# URL HTTPS pública do webhook (documentação / ops — cadastro via API)
# PIX_WEBHOOK_PUBLIC_URL=https://seu-host/pix/webhook

# Rotina diária cartão D-1 (sempre ontem, America/Sao_Paulo)
# Valor inicial; o painel (aba Scheduler, admin) liga/desliga em runtime e persiste.
# true em prod/homolog com uvicorn SEM --reload
# Stone cartão: só após 04:00 BRT. Não use 01:00 — a API retorna HTTP 400.
# Horário: CARTAO_CRON_HOUR (0-23) + CARTAO_CRON_MINUTE (0-59)
# Ex.: 04:00 → HOUR=4 MINUTE=0 | 06:30 → HOUR=6 MINUTE=30
CARTAO_CRON_ENABLED=false
# Com LOTE_AGUARDA_PIX_WEBHOOK=true o cron de cartão é fallback (webhook dispara o principal).
# Preferível: PIX ~04:05, cartão fallback ~05:30.
CARTAO_CRON_HOUR=5
CARTAO_CRON_MINUTE=30
# Segunda tentativa D-1 (mesmo dia anterior)
CARTAO_CRON_RETRY_HOUR=6
CARTAO_CRON_RETRY_MINUTE=0
CARTAO_CRON_TZ=America/Sao_Paulo

# Rotina diária PIX D-1 (solicita extrato; entrega via webhook)
# Painel Scheduler liga/desliga em runtime e persiste.
# PIX liberado ~03:00; alinhar (>= 04:00). Ex.: 04:05 + retry 05:05
PIX_CRON_ENABLED=false
PIX_CRON_HOUR=4
PIX_CRON_MINUTE=5
PIX_CRON_RETRY_HOUR=5
PIX_CRON_RETRY_MINUTE=5

# true = cartão do dia só após webhook PIX (mesmo arquivo vazio). Cron cartão = fallback.
LOTE_AGUARDA_PIX_WEBHOOK=true

# Auditoria do scheduler no portal (mesmo token em tasy-insercao)
PORTAL_BASE_URL=http://127.0.0.1:8001
PORTAL_INTERNAL_TOKEN=

# Após cron cartão OK: chama tasy-insercao para FECHAR recebimentos abertos (D-1).
# Delay (minutos) para a fila drenar antes da confirmação. false = só manual via API.
FECHAR_RECEB_ENABLED=false
FECHAR_RECEB_DELAY_MINUTES=45

APP_NAME=stone-extracao
APP_ENV=homolog
